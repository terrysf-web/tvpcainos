# Anamnesis(성찬주일 찬양팀) 빌드 설정 — `npx vite build --mode anamnesis` 로 빌드.
# 새 Firebase 프로젝트의 firebaseConfig 값으로 아래 6줄을 채우세요.
# (Firebase web apiKey는 공개값이라 저장소에 둬도 보안 문제 없음)
VITE_FB_API_KEY=AIzaSyD6EOTXMpe_2p9bijTe2dspuN8OJmYjZFI
VITE_FB_AUTH_DOMAIN=anamnesis-301d8.firebaseapp.com
VITE_FB_PROJECT_ID=anamnesis-301d8
VITE_FB_STORAGE_BUCKET=anamnesis-301d8.firebasestorage.app
VITE_FB_MSG_SENDER_ID=960642227269
VITE_FB_APP_ID=1:960642227269:web:7752c183e8131a5052572c

# 앱 이름(제목/설명/알림에 사용)
VITE_APP_TITLE=Anamnesis

# (선택) 홈 배경 — 세로화면(폰)=VITE_APP_BG, 가로화면(PC)=VITE_APP_BG_PC
VITE_APP_BG=/Vertical.webp
VITE_APP_BG_PC=/Horizon.webp
# (선택) 팀 유튜브 채널/재생목록 — 없으면 홈 유튜브 버튼 숨김
VITE_APP_YOUTUBE=

# 라이트(장비·X32·ProPresenter 숨김) — 성찬팀은 장비 기능 불필요
VITE_GUEST=1

# AI 도움(악보 분석·보이싱)용 Gemini 키 (선택)
VITE_GEMINI_API_KEY=
